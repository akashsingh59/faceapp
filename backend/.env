# Leave DATABASE_URL empty to use the in-memory local prototype.
DATABASE_URL=postgresql+psycopg://postgres:amizone5@localhost:5432/faceapp

# Real S3 presigned upload/download URLs are enabled when AWS_S3_BUCKET is set.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=faceapp-events

# Real Rekognition calls are enabled only when this is true.
AWS_REKOGNITION_ENABLED=true
